<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
         
    <!-- Versión del modelo de configuración de Maven (siempre es 4.0.0) -->
    <modelVersion>4.0.0</modelVersion>
    
    <!-- Identificadores únicos de tu proyecto -->
    <groupId>com.biblioteca</groupId>
    <artifactId>biblioteca-ues</artifactId>
    <version>1.0.0</version>
    
    <!-- Propiedades generales del proyecto -->
    <properties>
        <!-- Le indicamos al compilador que use las características de Java 21 -->
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Soporte para caracteres especiales del español -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    
    <!-- Dependencias: Herramientas de terceros que nuestro programa necesita -->
    <dependencies>
        <!-- Driver de MongoDB: Permite conectar el programa con tu base de datos -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
            <version>5.5.1</version>
        </dependency>
    </dependencies>
    
    <!-- Configuración de construcción: Cómo se compilará y ejecutará el código -->
    <build>
        <plugins>
            <!-- Plugin para compilar el código fuente usando la versión correcta de Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            
            <!-- Plugin para ejecutar tu programa de forma sencilla desde Maven -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <!-- Esta es la clase principal que Maven buscará para iniciar tu programa -->
                    <mainClass>com.biblioteca.app.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
    
</project>

